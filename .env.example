# Copy to .env.development.local for the local demo; real values live in .env.local / Vercel.
# Never commit real values.

# --- Merchant sign-in (always required) -------------------------------------
# 32+ random characters, signs the dashboard session cookie.
ADMIN_SESSION_SECRET=

# --- Local demo (leave the Neon and Stripe variables unset) ---------------------------
# Data lives in .data/store.json; payments use the built-in demo payment page.
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_WEBHOOK_SECRET=

# --- Production data: Neon (see docs/neon-database.md) -----------------------
# `neon link` + `neon deploy` + `npm run db:migrate -- --set-passwords` write these to
# .env.local. In Vercel set only the three runtime-role URLs and the four AWS_* variables.
EMBLARA_APP_DATABASE_URL=
EMBLARA_PUBLIC_DATABASE_URL=
# Customer-link routes use this role only. It has no table access.
EMBLARA_PORTAL_DATABASE_URL=
# 32 random bytes encoded as base64; encrypts the staff-copyable part of a quote link.
LINK_ENCRYPTION_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Admin scripts only (owner role). Never set these in Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Production payments: Stripe --------------------------------------------
# Webhook endpoint: https://YOUR-SITE/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public origin used for Stripe redirects (optional; derived from the request otherwise).
SITE_URL=
