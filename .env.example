# Copy to .env.development.local for the local demo, or set in Vercel for a real deployment.
# Never commit real values.

# --- Merchant sign-in (always required) -------------------------------------
# 32+ random characters, signs the dashboard session cookie.
ADMIN_SESSION_SECRET=

# --- Local demo (leave Supabase and Stripe unset) ---------------------------
# Data lives in .data/store.json; payments use the built-in demo payment page.
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=
DEMO_WEBHOOK_SECRET=

# --- Production data: Supabase (server only) --------------------------------
# Run supabase/migrations/001_store.sql, add staff to store_staff AND to Supabase Auth.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Production payments: Stripe --------------------------------------------
# Webhook endpoint: https://YOUR-SITE/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public origin used for Stripe redirects (optional; derived from the request otherwise).
SITE_URL=
