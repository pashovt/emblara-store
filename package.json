{
  "name": "emblara-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "seed": "node --env-file=.env.local scripts/seed-products.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:create-staff": "node --env-file=.env.local scripts/create-staff.mjs",
    "db:check": "node --env-file=.env.local scripts/check-db-security.mjs",
    "db:check:backoffice": "node --env-file=.env.local scripts/check-backoffice-db.mjs",
    "db:import-catalogue": "node --env-file=.env.local scripts/import-catalogue.mjs",
    "db:purge-artwork": "node --env-file=.env.local scripts/purge-artwork.mjs",
    "stripe:check": "node --env-file=.env.local scripts/check-stripe-checkout.mjs",
    "stripe:order": "node --env-file=.env.local --env-file=.env.development.local scripts/stripe-test-order.mjs",
    "stripe:webhook": "node --env-file=.env.local scripts/register-stripe-webhook.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@neon/config": "^1.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0"
  }
}
